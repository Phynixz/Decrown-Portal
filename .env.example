# Copy to .env and fill in real values. NEVER commit .env.

# MongoDB — use your Atlas connection string (mongodb+srv://user:pass@cluster/…)
# URL-encode special characters in the password (%40 for @, %23 for #, etc.)
# In local development, leaving this blank or setting a localhost URI will trigger an
# in-memory MongoDB fallback automatically if no database server is running.
MONGO_URI=

# Any long random string — signs admin & tenant JWT tokens (e.g. openssl rand -hex 32)
JWT_SECRET=

# Root domain with wildcard DNS and TLS for tenant subdomains
PLATFORM_ROOT_DOMAIN=yourplatform.com
VITE_PLATFORM_ROOT_DOMAIN=yourplatform.com

# Cloudinary account (for uploaded proof images / PDFs)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Default admin accounts seeded on first boot (any of 2/3 may be left blank)
ADMIN_EMAIL_1=
ADMIN_PASS_1=
ADMIN_EMAIL_2=
ADMIN_PASS_2=
ADMIN_EMAIL_3=
ADMIN_PASS_3=

# Platform owner login for the overall admin dashboard
PLATFORM_ADMIN_NAME=
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD= # use at least 12 characters

# Platform client verification emails (optional for local testing)
# Without RESEND_API_KEY, verification codes are printed in the server log.
RESEND_API_KEY=
PLATFORM_EMAIL_FROM=onboarding@yourdomain.com

# Optional
# PORT=3000
# NODE_ENV=production
# CLIENT_ORIGIN=https://your-app.onrender.com
